{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EAA repository record",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+$"
    },
    "kind": {
      "enum": [
        "source",
        "jurisdiction",
        "applicability",
        "requirement",
        "mapping",
        "test_execution",
        "evidence",
        "outcome_finding",
        "issue",
        "legal_limitation",
        "delegation",
        "approval",
        "conformity_conclusion",
        "public_claim",
        "monitoring_event"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "recorded",
        "complete",
        "blocked",
        "approved",
        "published",
        "superseded",
        "withdrawn"
      ]
    },
    "scope": {
